---
import site from '../data/site.json';
const baseP = import.meta.env.BASE_URL.replace(/\/$/, '');
const path = Astro.url.pathname.replace(baseP, '').replace(/\/$/, '') || '/';
const links = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About' },
  { href: '/skills', label: 'Skills' },
  { href: '/experience', label: 'Experience' },
  { href: '/education', label: 'Education' },
  { href: '/portfolio', label: 'Portfolio' },
  { href: '/contact', label: 'Contact' },
];
const aboutGroup = links.filter((l) => ['/about', '/skills', '/experience', '/education'].includes(l.href));
const inAbout = aboutGroup.some((l) => l.href === path);
const isActive = (href: string) =>
  href === '/' ? path === '/' : path === href || (href === '/portfolio' && path.startsWith('/work'));
---
<header class="hdr">
  <div class="container hdr__in">
    <a class="hdr__name" href="/">{site.name}</a>
    <a class="hdr__cta" href="/contact/">Let's talk</a>
    <nav id="nav" class="hdr__nav" aria-label="Main">
      <ul>
        {links.map((l) => (
          <li><a href={l.href === '/' ? '/' : `${l.href}/`} aria-current={isActive(l.href) ? 'page' : undefined}>{l.label}</a></li>
        ))}
      </ul>
    </nav>
  </div>
  {inAbout && (
    <nav class="subtabs" aria-label="About sections">
      <div class="subtabs__in">
        {aboutGroup.map((l) => (
          <a href={`${l.href}/`} aria-current={l.href === path ? 'page' : undefined}>{l.label}</a>
        ))}
      </div>
    </nav>
  )}
</header>
<style>
  .hdr { position: sticky; top: 0; z-index: 20; background: color-mix(in srgb, var(--surface) 86%, transparent); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); border-bottom: 1px solid var(--line); }
  .hdr__in { display: flex; align-items: center; justify-content: space-between; height: 64px; }
  .hdr__name { font: 600 20px/1 var(--font-display); letter-spacing: -.03em; color: var(--ink); text-decoration: none; white-space: nowrap; }
  .hdr__name::before { content: ""; display: inline-block; width: 8px; height: 8px; margin-right: 10px; border-radius: 2px; background: var(--accent); box-shadow: 0 0 10px var(--accent); vertical-align: 2px; }
  .hdr__name:hover { color: var(--ink); }
  ul { display: flex; gap: var(--space-6); list-style: none; margin: 0; padding: 0; }
  nav a { position: relative; font: 500 12px/16px var(--font-mono); letter-spacing: .08em; text-transform: uppercase; color: var(--ink-muted); text-decoration: none; padding: 6px 0; }
  nav a:hover { color: var(--cyan); }
  nav a[aria-current='page'] { color: var(--ink); }
  nav a[aria-current='page']::after { content: ""; position: absolute; left: 0; right: 0; bottom: -2px; height: 2px; background: var(--accent); box-shadow: 0 0 8px var(--accent); border-radius: 2px; }
  .hdr__cta, .subtabs { display: none; }

  /* Phones: the bottom tab bar (TabBar.astro) replaces the menu */
  @media (max-width: 900px) {
    .hdr__in { height: 56px; }
    .hdr__nav { display: none; }
    .hdr__cta { display: inline-flex; align-items: center; height: 34px; padding: 0 14px; border: 1px solid var(--line-strong); border-radius: 999px; font: 500 11px/1 var(--font-mono); letter-spacing: .08em; text-transform: uppercase; color: var(--ink); text-decoration: none; }
    .hdr__cta:hover { color: var(--cyan); border-color: var(--cyan); }
    .subtabs { display: block; border-top: 1px solid var(--line); }
    .subtabs__in { display: flex; gap: 8px; overflow-x: auto; padding: 10px var(--gutter); scrollbar-width: none; }
    .subtabs__in::-webkit-scrollbar { display: none; }
    .subtabs a { flex: none; padding: 7px 14px; border-radius: 999px; border: 1px solid var(--line); font: 500 11px/1 var(--font-mono); letter-spacing: .06em; text-transform: uppercase; color: var(--ink-muted); text-decoration: none; }
    .subtabs a[aria-current='page'] { color: var(--on-accent); background: var(--accent); border-color: var(--accent); box-shadow: 0 0 14px color-mix(in srgb, var(--accent) 60%, transparent); }
    .subtabs a::after { display: none; }
  }
</style>

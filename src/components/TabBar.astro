---
// Phone-only bottom tab bar (≤ 900px). Desktop keeps the normal header nav.
const baseP = import.meta.env.BASE_URL.replace(/\/$/, '');
const path = Astro.url.pathname.replace(baseP, '').replace(/\/$/, '') || '/';
const aboutGroup = ['/about', '/skills', '/experience', '/education'];

const tabs = [
  { href: '/', label: 'Home', on: path === '/', icon: 'M3 10.5 12 3l9 7.5V20a1 1 0 0 1-1 1h-5v-6h-6v6H4a1 1 0 0 1-1-1z' },
  { href: '/portfolio/', label: 'Work', on: path === '/portfolio' || path.startsWith('/work'), icon: 'M4 4h7v7H4zM13 4h7v7h-7zM4 13h7v7H4zM13 13h7v7h-7z' },
  { href: '/about/', label: 'About', on: aboutGroup.includes(path), icon: 'M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8zM4 21a8 8 0 0 1 16 0' },
  { href: '/contact/', label: 'Contact', on: path === '/contact', icon: 'M4 5h16a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1zM3.5 6.5 12 13l8.5-6.5' },
];
const hideOnScroll = path.startsWith('/work');
---
<nav class="tabbar" aria-label="Main (mobile)" data-autohide={hideOnScroll ? '' : undefined}>
  {tabs.map((t) => (
    <a href={t.href} class="tab" aria-current={t.on ? 'page' : undefined}>
      <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d={t.icon} /></svg>
      <span>{t.label}</span>
    </a>
  ))}
</nav>

{hideOnScroll && (
  <script>
    // Case studies: slide the bar away while reading (scrolling down), bring it back on scroll up.
    const bar = document.querySelector<HTMLElement>('.tabbar[data-autohide]');
    let last = window.scrollY, ticking = false;
    window.addEventListener('scroll', () => {
      if (ticking || !bar) return;
      ticking = true;
      requestAnimationFrame(() => {
        const y = window.scrollY, nearEnd = window.innerHeight + y > document.body.scrollHeight - 80;
        bar.classList.toggle('is-hidden', y > last && y > 160 && !nearEnd);
        last = y; ticking = false;
      });
    }, { passive: true });
  </script>
)}

<style>
  .tabbar { display: none; }
  @media (max-width: 900px) {
    .tabbar {
      position: fixed; z-index: 30; left: 0; right: 0; bottom: 0;
      display: grid; grid-template-columns: repeat(4, 1fr);
      padding: 6px 8px calc(6px + env(safe-area-inset-bottom));
      background: color-mix(in srgb, var(--surface) 96%, transparent);
      backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px);
      border-top: 1px solid var(--line);
      transition: transform .25s ease;
    }
    .tabbar.is-hidden { transform: translateY(110%); }
    .tab {
      position: relative; display: grid; justify-items: center; gap: 3px; padding: 6px 0 4px;
      color: var(--ink-faint); text-decoration: none; border-radius: 12px;
      font: 500 10.5px/1 var(--font-mono); letter-spacing: .06em; text-transform: uppercase;
      -webkit-tap-highlight-color: transparent;
    }
    .tab svg { fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; transition: transform .15s; }
    .tab:active svg { transform: scale(.9); }
    .tab[aria-current='page'] { color: var(--accent-text); }
    .tab[aria-current='page'] svg { filter: drop-shadow(0 0 6px var(--accent)); }
    .tab[aria-current='page']::before {
      content: ""; position: absolute; top: -7px; width: 18px; height: 3px; border-radius: 0 0 3px 3px;
      background: var(--cyan); box-shadow: 0 0 8px var(--cyan);
    }
  }
</style>

---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeader from '../components/SectionHeader.astro';
import site from '../data/site.json';
import c from '../data/contact.json';

const linkedin = site.socials.find((s) => s.label === 'LinkedIn')?.url;
const methods = [
  { k: 'Email', v: site.email, href: `mailto:${site.email}`, note: 'Response within 24 hours' },
  site.phone && { k: 'Phone', v: site.phone, href: `tel:${site.phone.replace(/\s/g, '')}`, note: c.availability },
  site.whatsapp && { k: 'WhatsApp', v: 'Message on WhatsApp', href: `https://wa.me/${site.whatsapp}`, note: 'Usually replies within a few hours' },
  linkedin && { k: 'LinkedIn', v: 'Connect on LinkedIn', href: linkedin, note: 'Open to recruiter messages' },
].filter(Boolean) as { k: string; v: string; href: string; note: string }[];
const socials = site.socials.filter((s) => s.url);
---
<Base title="Contact" description={c.intro}>
  <PageHero label="Contact" title={c.title} intro={c.intro}>
    {site.openToWork && <p style="margin-top: var(--space-6)"><span class="vi-tag vi-tag--status">Open to work</span></p>}
  </PageHero>

  <section class="section container" style="padding-top: var(--space-12)" aria-label="Ways to reach me">
    <div class="methods">
      {methods.map((m, i) => (
        <a class:list={['panel', 'method', { 'panel--lit': i === 0 }]} href={m.href} target={m.href.startsWith('http') ? '_blank' : undefined} rel="noopener">
          <span class="vi-label"><b>0{i + 1}</b> / {m.k}</span>
          <span class="method__v">{m.v}</span>
          <span class="method__n">{m.note}</span>
        </a>
      ))}
    </div>
  </section>

  <section class="section container" aria-labelledby="form-title">
    <div class="split">
      <div>
        <SectionHeader n="01" id="form-title">Send a <em>message</em></SectionHeader>
        {site.formKey ? (
        <form class="form" id="contact-form" method="POST" action="https://api.web3forms.com/submit">
          <input type="hidden" name="access_key" value={site.formKey} />
          <input type="hidden" name="subject" value={`New message from ${site.name} portfolio`} />
          <input type="hidden" name="from_name" value={`${site.name} — portfolio`} />
          <input type="hidden" name="redirect" value={Astro.site ? new URL(import.meta.env.BASE_URL.replace(/\/?$/, '/') + 'thanks/', Astro.site).href : 'https://web3forms.com/success'} />
          <input type="checkbox" name="botcheck" class="botcheck" tabindex="-1" autocomplete="off" aria-hidden="true" />
          <div class="row2">
            <label>Full name *<input name="name" required autocomplete="name" /></label>
            <label>Email *<input type="email" name="email" required autocomplete="email" /></label>
          </div>
          <div class="row2">
            <label>Company / organisation<input name="company" autocomplete="organization" /></label>
            <label>Phone<input type="tel" name="phone" autocomplete="tel" /></label>
          </div>
          <fieldset>
            <legend>What's this about? *</legend>
            <div class="radios">
              {c.projectTypes.map((t, i) => (
                <label class="radio"><input type="radio" name="type" value={t} required checked={i === 0} /><span>{t}</span></label>
              ))}
            </div>
          </fieldset>
          <label>Budget (for projects)
            <select name="budget">
              <option value="">Not applicable / not sure</option>
              <option>Under ₹50,000</option>
              <option>₹50,000 – ₹1,50,000</option>
              <option>₹1,50,000+</option>
              <option>Hourly</option>
            </select>
          </label>
          <label>Message *<textarea name="message" rows="6" required placeholder="Tell me about the role or project, timelines and anything else useful."></textarea></label>
          <button class="vi-btn vi-btn--primary" type="submit">Send message →</button>
        </form>
        ) : (
          <div class="panel panel--lit">
            <p style="color: var(--ink)">The quickest way to reach me is email.</p>
            <p style="margin-top: var(--space-6)"><a class="vi-btn vi-btn--primary" href={`mailto:${site.email}`}>Email {site.email}</a></p>
          </div>
        )}
      </div>

      <aside>
        <SectionHeader n="02">FAQ</SectionHeader>
        <div class="faq">
          {c.faq.map((f) => (
            <details>
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
        <div class="panel" style="margin-top: var(--space-8)">
          <p class="vi-label"><b>//</b> Elsewhere</p>
          <div class="tags">{socials.map((s) => <a class="vi-btn vi-btn--secondary" href={s.url} target="_blank" rel="noopener">{s.label} ↗</a>)}</div>
        </div>
      </aside>
    </div>
  </section>
</Base>
<script>
  // Send the visitor back to /thanks/ on whichever domain they're on (preview or live).
  const form = document.getElementById('contact-form');
  const r = form?.querySelector<HTMLInputElement>('input[name="redirect"]');
  if (r) r.value = new URL(import.meta.env.BASE_URL.replace(/\/?$/, '/') + 'thanks/', location.origin).href;
</script>
<style>
  .botcheck { display: none; }
  .methods { display: grid; gap: var(--space-4); }
  @media (min-width: 720px) { .methods { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1100px) { .methods { grid-template-columns: repeat(4, 1fr); } }
  .method { display: grid; gap: var(--space-2); text-decoration: none; transition: box-shadow .2s, border-color .2s; }
  .method:not(.panel--lit):hover { border-color: transparent; box-shadow: var(--glow-cyan); }
  .method__v { font: 600 16px/1.35 var(--font-display); letter-spacing: -.01em; color: var(--ink); overflow-wrap: anywhere; }
  .method__n { font-size: 13px; line-height: 20px; color: var(--ink-muted); }

  .split { display: grid; gap: var(--space-16); }
  @media (min-width: 1000px) { .split { grid-template-columns: 1.5fr 1fr; } }

  .form { display: grid; gap: var(--space-6); }
  .row2 { display: grid; gap: var(--space-6); }
  @media (min-width: 640px) { .row2 { grid-template-columns: 1fr 1fr; } }
  label, legend { display: grid; gap: var(--space-2); font: 500 12px/16px var(--font-mono); letter-spacing: .06em; text-transform: uppercase; color: var(--ink-muted); }
  input, select, textarea { width: 100%; font: 400 16px/24px var(--font-sans); color: var(--ink); background: var(--surface-raised); border: 1px solid var(--line-strong); border-radius: var(--radius-sm); padding: 12px 14px; text-transform: none; letter-spacing: 0; transition: border-color .2s, box-shadow .2s; }
  input:focus, select:focus, textarea:focus { outline: none; border-color: var(--cyan); box-shadow: 0 0 0 3px rgba(34, 230, 255, .2); }
  textarea { resize: vertical; }
  fieldset { border: 0; padding: 0; margin: 0; }
  legend { margin-bottom: var(--space-3); }
  .radios { display: flex; flex-wrap: wrap; gap: var(--space-2); }
  .radio { display: block; }
  .radio input { position: absolute; opacity: 0; width: 1px; height: 1px; }
  .radio span { display: inline-block; padding: 8px 14px; border: 1px solid var(--line-strong); border-radius: var(--radius-pill); color: var(--ink-muted); cursor: pointer; transition: all .2s; }
  .radio input:checked + span { color: var(--on-accent); background: var(--accent); border-color: var(--accent); box-shadow: var(--glow-accent); }
  .radio input:focus-visible + span { outline: 2px solid var(--focus-ring); outline-offset: 3px; }
  .form button { justify-self: start; }

  .faq details { border-top: 1px solid var(--line); padding: var(--space-4) 0; }
  .faq details:last-child { border-bottom: 1px solid var(--line); }
  .faq summary { cursor: pointer; list-style: none; display: flex; justify-content: space-between; gap: var(--space-4); font: 600 17px/1.4 var(--font-display); letter-spacing: -.015em; }
  .faq summary::-webkit-details-marker { display: none; }
  .faq summary::after { content: "+"; font-family: var(--font-mono); color: var(--cyan); }
  .faq details[open] summary::after { content: "–"; }
  .faq p { margin: var(--space-3) 0 0; color: var(--ink-muted); }
</style>

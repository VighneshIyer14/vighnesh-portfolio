---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeader from '../components/SectionHeader.astro';
import Stats from '../components/Stats.astro';
import CTA from '../components/CTA.astro';
import site from '../data/site.json';
import about from '../data/about.json';
import education from '../data/education.json';
import { dateRange } from '../lib/util';
---
<Base title="About" description={about.intro}>
  <PageHero label="About" title={about.title} intro={about.intro} />
  <div class="container" style="margin-top: var(--space-12)"><Stats items={site.stats} /></div>

  <section class="section container" aria-labelledby="ph">
    <SectionHeader n="01" id="ph">Design <em>philosophy</em></SectionHeader>
    <div class="phil">
      <blockquote class="quote">{about.quote}</blockquote>
      <ul class="principles">
        {about.principles.map((p, i) => <li><span class="vi-label"><b>0{i + 1}</b></span>{p}</li>)}
      </ul>
    </div>
  </section>

  <section class="section container" aria-labelledby="ev">
    <SectionHeader n="02" id="ev">Professional <em>evolution</em></SectionHeader>
    <ol class="timeline">
      {about.timeline.map((t) => (
        <li>
          <span class="vi-label"><b>Phase {t.phase}</b></span>
          <h3 class="tl__title">{t.title}</h3>
          <p class="muted" style="max-width: 680px; margin: var(--space-3) 0 0; color: var(--ink-muted)">{t.text}</p>
          <div class="tags">{t.tags.map((x) => <span class="vi-tag">{x}</span>)}</div>
        </li>
      ))}
    </ol>
  </section>

  <section class="section container" aria-labelledby="why">
    <SectionHeader n="03" id="why">Why VFX makes <em>better UX</em></SectionHeader>
    <div class="cols-3">
      {about.why.map((w, i) => (
        <article class:list={['panel', { 'panel--lit': i === 2 }]}>
          <h3>{w.title}</h3>
          <p>{w.text}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="section container" aria-labelledby="ed">
    <SectionHeader n="04" id="ed">Education<a slot="aside" class="vi-btn vi-btn--ghost" href="/education/">Details →</a></SectionHeader>
    <div class="cols-3">
      {education.items.map((e) => (
        <article class="panel">
          {dateRange(e) && <p class="vi-label">{dateRange(e)}</p>}
          <h3 style="margin-top: var(--space-3)">{e.title}</h3>
          <p>{e.org}{e.grade && <span> · <strong style="color: var(--cyan); font-weight: 500">{e.grade}</strong></span>}</p>
        </article>
      ))}
    </div>
  </section>

  <CTA title="Ready to experience *dimensional* design?" text="Let's work together and bring a cinematic perspective to your product's experience." />
</Base>
<style>
  .phil { display: grid; gap: var(--space-12); }
  @media (min-width: 900px) { .phil { grid-template-columns: 2fr 1fr; align-items: start; gap: var(--space-16); } }
  .quote { margin: 0; padding-left: var(--space-6); border-left: 2px solid var(--cyan); font: 500 clamp(20px, 2.4vw, 26px)/1.45 var(--font-display); letter-spacing: -.015em; color: var(--ink); }
  .principles { list-style: none; margin: 0; padding: 0; }
  .principles li { display: flex; gap: var(--space-4); align-items: baseline; padding: var(--space-4) 0; border-top: 1px solid var(--line); font: 600 20px/1.3 var(--font-display); letter-spacing: -.02em; }
  .principles li:last-child { border-bottom: 1px solid var(--line); }
</style>

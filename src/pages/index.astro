---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SectionHeader from '../components/SectionHeader.astro';
import site from '../data/site.json';
import Stats from '../components/Stats.astro';
import StatusBadge from '../components/StatusBadge.astro';
import CTA from '../components/CTA.astro';
import { getProjects, emph } from '../lib/util';

const selected = (await getProjects()).slice(0, 5);
const company = ((site as { currentCompany?: string }).currentCompany || '').trim();
import GridBg from '../components/GridBg.astro';
---
<Base>
  <section class="hero container" aria-labelledby="hero-title">
    <GridBg />
    <svg class="hero__art" viewBox="0 0 400 520" aria-hidden="true">
      <rect class="a-uv" x="0" y="-20" width="120" height="400" rx="10" />
      <rect class="a-cy" x="136" y="300" width="104" height="80" rx="10" />
      <rect class="a-film" x="256" y="120" width="160" height="260" rx="10" />
      {[0, 1, 2, 3, 4].map((i) => <rect class="a-hole" x={270 + i * 30} y="134" width="14" height="10" rx="3" />)}
      {[0, 1, 2, 3, 4].map((i) => <rect class="a-hole" x={270 + i * 30} y="356" width="14" height="10" rx="3" />)}
    </svg>
    <div class="hero__meta">
      <StatusBadge />
      <span class="vi-label">{site.role} · {site.location}</span>
    </div>
    <h1 class="display-xl hero__title" id="hero-title" set:html={emph(site.headline)} />
    <p class="body-lg hero__intro">{site.intro}</p>
    <div class="hero__cta">
      <a class="vi-btn vi-btn--primary" href="/portfolio/">View work</a>
      {site.cv && <a class="vi-btn vi-btn--secondary" href={site.cv} target="_blank" rel="noopener">Download CV</a>}
      <a class="vi-btn vi-btn--ghost" href="/contact/">Get in touch →</a>
    </div>
  </section>

  <div class="container section--tight"><Stats items={site.stats} /></div>

  <section class="section container" aria-labelledby="do-title">
    <SectionHeader n="01" id="do-title">What I <em>do</em></SectionHeader>
    <div class="cols-3">
      {site.highlights.map((h, i) => (
        <article class:list={['panel', { 'panel--lit': i === 0 }]}>
          <p class="vi-label"><b>0{i + 1}</b> / Discipline</p>
          <h3 style="margin-top: var(--space-4)">{h.title}</h3>
          <p>{h.text}</p>
          <div class="tags">{h.tools.map((t) => <span class="vi-tag">{t}</span>)}</div>
        </article>
      ))}
    </div>
  </section>

  <section class="section container" id="work" aria-labelledby="work-title">
    <SectionHeader n="02" id="work-title">Selected <em>work</em><a slot="aside" class="vi-btn vi-btn--ghost" href="/portfolio/">All projects →</a></SectionHeader>
    <div class="grid">
      {selected.map((p, i) => <ProjectCard project={p} index={i} featured={i === 0 && p.data.featured} />)}
    </div>
  </section>

  <CTA title="Ready to bring *dimensional thinking* to your product?" text={site.openToWork || !company ? "I'm looking for product design roles in B2B, SaaS and fintech — and I'm always happy to talk about a good project." : `I'm currently working at ${company} — and always happy to talk about a good project.`} />
</Base>

<style>
  .hero { padding-top: var(--space-32); position: relative; isolation: isolate; }
  .hero__art { position: absolute; top: 0; right: var(--gutter); width: min(18vw, 260px); height: auto; pointer-events: none; }
  .a-uv { fill: var(--accent); filter: drop-shadow(0 0 18px rgba(176, 38, 255, .6)); } .a-cy { fill: var(--cyan); filter: drop-shadow(0 0 14px rgba(34, 230, 255, .5)); }
  .a-film { fill: var(--ink); } .a-hole { fill: var(--surface); }
  @media (max-width: 1280px) { .hero__art { display: none; } }
  @media (max-width: 720px) { .hero { padding-top: var(--space-16); } }
  .hero__meta { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-4); margin-bottom: var(--space-8); }
  .hero__title { max-width: 14ch; position: relative; }
  .hero__intro { max-width: 620px; margin: var(--space-8) 0 0; }
  .hero__cta { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-4) var(--space-6); margin-top: var(--space-12); }

  .grid { display: grid; grid-template-columns: 1fr; gap: var(--space-6); }
  @media (min-width: 900px) { .grid { grid-template-columns: 1fr 1fr; gap: var(--space-8); } }

  .section--tight { margin-top: var(--space-16); }
</style>

---
import Base from '../layouts/Base.astro';
import GridBg from '../components/GridBg.astro';
---
<Base title="Message sent">
  <section class="page-hero container" style="min-height: 50vh">
    <GridBg />
    <p class="vi-tag vi-tag--status">Message received</p>
    <h1 class="display-lg page-hero__title">Thanks — I'll be in touch <em>soon</em>.</h1>
    <p class="body-lg page-hero__intro">I usually reply within 24 hours.</p>
    <p style="margin-top: var(--space-8)"><a class="vi-btn vi-btn--primary" href="/portfolio/">Back to the work</a></p>
  </section>
</Base>

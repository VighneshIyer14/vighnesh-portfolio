---
import Base from '../layouts/Base.astro';
import GridBg from '../components/GridBg.astro';
---
<Base title="Not found">
  <section class="container page-hero" style="padding-top: var(--space-32); min-height: 50vh;">
    <GridBg />
    <p class="vi-label"><b>404</b> / Missing frame</p>
    <h1 class="display-lg" style="margin-top: var(--space-4);">This page didn't make the <em>final cut</em>.</h1>
    <p style="margin-top: var(--space-8);"><a class="vi-btn vi-btn--primary" href="/">Back home</a></p>
  </section>
</Base>

---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import GridBg from '../../components/GridBg.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import CTA from '../../components/CTA.astro';
import CaseBlocks from '../../components/CaseBlocks.astro';
import { getProjects } from '../../lib/util';
import { marked } from 'marked';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project, i) => ({
    params: { slug: project.id },
    props: { project, index: i, next: projects[(i + 1) % projects.length] },
  }));
}

const { project, index, next } = Astro.props;
const d = project.data;
const { Content } = await render(project);
const n = String(index + 1).padStart(2, '0');
const facts = [
  { k: 'Discipline', v: d.discipline },
  { k: 'Category', v: d.category },
  { k: 'Role', v: d.role },
  { k: d.year ? 'Year' : 'Tools', v: d.year || d.tools.join(', ') },
].filter((f) => f.v);
const tools = d.year ? d.tools : [];

/**
 * The write-up can place builder blocks inside itself with a marker on its own line:
 *   [[1]]  → the 1st block in the Case study builder
 * Text is split at those markers; blocks that aren't placed are shown after the text.
 */
const raw = (project.body || '').trim();
const blocks = d.content as any[];
const used = new Set<number>();
const parts: Array<{ html?: string; block?: any }> = [];
if (raw) {
  const chunks = raw.split(/^[ \t]*\[\[[ \t]*(\d+)[ \t]*\]\][ \t]*$/m);
  chunks.forEach((chunk, i) => {
    if (i % 2 === 1) {
      const idx = Number(chunk) - 1;
      if (blocks[idx]) { parts.push({ block: blocks[idx] }); used.add(idx); }
    } else if (chunk.trim()) {
      parts.push({ html: marked.parse(chunk, { async: false }) as string });
    }
  });
}
const leftover = blocks.filter((_, i) => !used.has(i));
---
<Base title={d.title} description={d.summary} image={d.cover}>
  <article>
    <!-- Header: same pattern as every other page (label → title → intro) -->
    <section class="page-hero container">
      <GridBg />
      <p class="vi-label crumbs">
        <a href="/portfolio/"><b>//</b> Portfolio</a>
        <span aria-hidden="true">/</span>
        <span><b>{n}</b> {d.discipline}</span>
      </p>
      <h1 class="display-lg page-hero__title">{d.title}</h1>
      <p class="body-lg page-hero__intro">{d.summary}</p>
      {(d.link || tools.length > 0 || d.tags.length > 0) && (
        <div class="head-meta">
          {d.link && <a class="vi-btn vi-btn--primary" href={d.link} target="_blank" rel="noopener">View live / prototype ↗</a>}
          <div class="tags" style="margin-top: 0">{[...tools, ...d.tags].slice(0, 6).map((t) => <span class="vi-tag">{t}</span>)}</div>
        </div>
      )}
    </section>

    <!-- Quick facts: same box style as the Stats strip -->
    <div class="container" style="margin-top: var(--space-12)">
      <dl class="facts">
        {facts.map((f) => (
          <div class="fact"><dt class="vi-label">{f.k}</dt><dd>{f.v}</dd></div>
        ))}
      </dl>
    </div>

    <div class="container">
      <figure class="cover"><img src={d.cover} alt={`${d.title} — cover`} /></figure>
    </div>

    <!-- Case study: left-aligned like other pages; each ## heading becomes a numbered section header -->
    <section class="section container" aria-label="Case study">
      <div class="prose">
        {parts.length > 0
          ? parts.map((p) => (p.block ? <CaseBlocks blocks={[p.block]} /> : <div set:html={p.html} />))
          : null}
        {leftover.length > 0 && <CaseBlocks blocks={leftover} />}
        {!raw && blocks.length === 0 && <Content />}
      </div>
    </section>

    {d.gallery.length > 0 && (
      <section class="section container" aria-labelledby="gal">
        <SectionHeader n="→" id="gal">Gallery</SectionHeader>
        <div class="gallery">
          {d.gallery.map((g) => (
            <figure class="panel shot">
              <img src={g.image} alt={g.caption || d.title} loading="lazy" decoding="async" />
              {g.caption && <figcaption class="vi-label">{g.caption}</figcaption>}
            </figure>
          ))}
        </div>
      </section>
    )}

    {next && next.id !== project.id && (
      <div class="container" style="margin-top: var(--space-24)">
        <a class="panel nextp" href={`/work/${next.id}/`}>
          <div>
            <span class="vi-label"><b>&gt;</b> Next project · {next.data.discipline}</span>
            <span class="nextp__t">{next.data.title}</span>
            <span class="nextp__s">{next.data.summary}</span>
          </div>
          <span class="nextp__arrow" aria-hidden="true">→</span>
        </a>
      </div>
    )}

    <CTA title="Like what you *see*?" text="Let's talk about the role or project — I reply within 24 hours." primary={['Get in touch', '/contact/']} secondary={['All projects', '/portfolio/']} />
  </article>
</Base>

<style>
  .crumbs { display: flex; flex-wrap: wrap; gap: var(--space-2); align-items: center; margin: 0; }
  .crumbs a { color: var(--ink-muted); text-decoration: none; }
  .crumbs a:hover { color: var(--cyan); }
  .head-meta { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-4) var(--space-6); margin-top: var(--space-8); }

  .facts { display: grid; grid-template-columns: repeat(2, 1fr); margin: 0; border: 1px solid var(--line); border-radius: var(--radius-md); overflow: hidden; }
  @media (min-width: 720px) { .facts { grid-template-columns: repeat(4, 1fr); } }
  .fact { padding: var(--space-6); border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); margin-bottom: -1px; }
  .fact:nth-child(2n) { border-right: 0; }
  @media (min-width: 720px) { .fact:nth-child(2n) { border-right: 1px solid var(--line); } .fact:last-child { border-right: 0; } }
  .fact dd { margin: var(--space-2) 0 0; font: 600 18px/1.3 var(--font-display); letter-spacing: -.01em; color: var(--ink); }

  .cover { margin: var(--space-8) 0 0; border: 1px solid var(--line); border-radius: var(--radius-md); overflow: hidden; background: var(--surface-sunken); }
  .cover img { width: 100%; aspect-ratio: 16 / 9; object-fit: cover; }

  /* Case-study body */
  .prose { counter-reset: sec; }
  .prose > :global(*) { max-width: 760px; }
  .prose :global(h2) {
    max-width: none; display: flex; align-items: baseline; gap: var(--space-4);
    margin: var(--space-16) 0 var(--space-6); padding-bottom: var(--space-4); border-bottom: 1px solid var(--line);
    font: 600 clamp(28px, 3.6vw, 36px)/1.1 var(--font-display); letter-spacing: -.03em; color: var(--ink);
  }
  .prose :global(h2:first-child) { margin-top: 0; }
  .prose :global(h2)::before { counter-increment: sec; content: '// ' counter(sec, decimal-leading-zero); font: 500 14px/20px var(--font-mono); letter-spacing: .06em; color: var(--cyan); }
  .prose :global(h3) { font: 600 22px/30px var(--font-display); letter-spacing: -.02em; margin: var(--space-8) 0 var(--space-2); }
  .prose :global(p), .prose :global(li) { color: var(--ink-muted); font-size: 17px; line-height: 28px; }
  .prose :global(p) { margin: 0 0 var(--space-4); }
  .prose :global(ul), .prose :global(ol) { margin: 0 0 var(--space-4); padding-left: 1.1em; }
  .prose :global(li) { margin-bottom: var(--space-2); }
  .prose :global(li::marker) { color: var(--cyan); }
  .prose :global(strong) { color: var(--ink); font-weight: 600; }
  .prose :global(a) { color: var(--accent-text); }
  .prose :global(img) { max-width: 100%; margin: var(--space-8) 0; border-radius: var(--radius-md); border: 1px solid var(--line); }
  .prose :global(blockquote) { margin: var(--space-8) 0; padding-left: var(--space-6); border-left: 2px solid var(--cyan); font: 500 clamp(20px, 2.4vw, 24px)/1.4 var(--font-display); letter-spacing: -.015em; color: var(--ink); }
  .prose :global(blockquote p) { color: inherit; font: inherit; }
  .prose :global(.blk-fig img), .prose :global(.blk-fig video) { margin: 0; }
  .prose :global(hr) { max-width: none; border: 0; border-top: 1px solid var(--line); margin: var(--space-16) 0; }

  .gallery { display: grid; gap: var(--space-6); }
  @media (min-width: 900px) { .gallery { grid-template-columns: 1fr 1fr; gap: var(--space-8); } }
  .shot { margin: 0; padding: var(--space-4); }
  .shot img { width: 100%; border-radius: var(--radius-sm); background: var(--surface-sunken); }
  .shot figcaption { margin-top: var(--space-3); }

  .nextp { display: flex; align-items: center; justify-content: space-between; gap: var(--space-6); text-decoration: none; color: var(--ink); transition: box-shadow .2s, border-color .2s; }
  .nextp:hover { color: var(--ink); border-color: transparent; box-shadow: var(--glow-cyan); }
  .nextp > div { display: grid; gap: var(--space-2); }
  .nextp__t { font: 600 clamp(28px, 3.6vw, 36px)/1.1 var(--font-display); letter-spacing: -.03em; }
  .nextp:hover .nextp__t { color: var(--accent-text); }
  .nextp__s { color: var(--ink-muted); max-width: 640px; }
  .nextp__arrow { font: 600 32px/1 var(--font-display); color: var(--cyan); transition: transform .2s; }
  .nextp:hover .nextp__arrow { transform: translateX(6px); }
</style>

---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeader from '../components/SectionHeader.astro';
import Stats from '../components/Stats.astro';
import CTA from '../components/CTA.astro';
import skills from '../data/skills.json';
const slug = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, '-');
const levelName = (n: number) => (n >= 80 ? 'Expert' : n >= 60 ? 'Advanced' : 'Intermediate');
---
<Base title="Skills" description={skills.intro}>
  <PageHero label="Skills" title={skills.title} intro={skills.intro} />

  <div class="container" style="margin-top: var(--space-12)">
    <div class="filters" role="group" aria-label="Filter skills">
      <button class="chip" type="button" data-filter="all" aria-pressed="true">All skills</button>
      {skills.groups.map((g) => <button class="chip" type="button" data-filter={slug(g.name)} aria-pressed="false">{g.name}</button>)}
    </div>
  </div>

  {skills.groups.map((g, gi) => (
    <section class="section container skill-group" data-group={slug(g.name)} style="padding-top: var(--space-12)">
      <SectionHeader n={String(gi + 1).padStart(2, '0')}>{g.name}<span slot="aside" class="vi-label">{g.note}</span></SectionHeader>
      <div class="cols-3">
        {g.items.map((s) => (
          <article class="panel skill">
            <div class="skill__top">
              <h3>{s.name}</h3>
              <span class="vi-label"><b>{s.level}%</b></span>
            </div>
            <p class="vi-label">{s.category} · {levelName(s.level)}</p>
            <div class="bar" role="meter" aria-valuemin="0" aria-valuemax="100" aria-valuenow={s.level} aria-label={`${s.name} proficiency`}>
              <span style={`width:${s.level}%`}></span>
            </div>
            <p>{s.text}</p>
            <div class="tags">{s.tags.map((t) => <span class="vi-tag">{t}</span>)}</div>
          </article>
        ))}
      </div>
    </section>
  ))}

  <section class="section container" aria-labelledby="glance">
    <SectionHeader n="→" id="glance">At a <em>glance</em></SectionHeader>
    <Stats items={skills.glance} />
  </section>

  <CTA title="Ready to put these skills to *work*?" text="Let's talk about how VFX craft and UI/UX process can shape your product." primary={['View my work', '/portfolio/']} secondary={['Start a project', '/contact/']} />
</Base>
<script>
  const chips = document.querySelectorAll<HTMLButtonElement>('.filters .chip');
  const groups = document.querySelectorAll<HTMLElement>('.skill-group');
  chips.forEach((c) => c.addEventListener('click', () => {
    const f = c.dataset.filter;
    chips.forEach((x) => x.setAttribute('aria-pressed', String(x === c)));
    groups.forEach((g) => { g.hidden = f !== 'all' && g.dataset.group !== f; });
  }));
</script>
<style>
  .skill { display: grid; gap: var(--space-3); align-content: start; }
  .skill__top { display: flex; justify-content: space-between; align-items: baseline; gap: var(--space-4); }
  .skill h3 { margin: 0; }
  .skill p { margin: 0; }
  .skill .tags { margin-top: 0; }
  .bar { height: 6px; background: var(--surface-sunken); border: 1px solid var(--line); border-radius: 999px; overflow: hidden; }
  .bar span { position: relative; display: block; height: 100%; border-radius: 999px; background: var(--accent); box-shadow: 0 0 12px rgba(176, 38, 255, .6); }
  .bar span::after { content: ""; position: absolute; right: 0; top: 0; bottom: 0; width: 6px; border-radius: 999px; background: var(--cyan); box-shadow: 0 0 8px var(--cyan); }
</style>
